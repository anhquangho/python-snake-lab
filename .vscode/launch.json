{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: FastAPI lab",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["snake_lab.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: pytest current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-vv", "-s"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
